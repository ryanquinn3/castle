{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "vitest/no-standalone-expect":"off",
  },
  "env": {
    "builtin": true
  }
  ,
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts"],
      "rules": {
        "no-empty-pattern": [
          "error",
          { "allowObjectPatternsAsParameters": true }
        ]
      }
    }
  ]
}
