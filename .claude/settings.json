
{
    "autoUpdates": false,
    "env":{
        "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
    },
  "bgIsolation": "none",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false,
    "superpowers@superpowers-marketplace": false
  },
  "permissions": {
    "allow": [
      "Bash(*)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "Explore",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/explore-rg-guidance.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-tool-guard.py\"",
            "statusMessage": "Checking bash command against tool-guard rules"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-file-guard.py\"",
            "statusMessage": "Checking file edit against subagent guard rules"
          }
        ]
      }
    ]
  }
}
