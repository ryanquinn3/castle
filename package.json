{
  "name": "castle",
  "version": "0.0.0",
  "description": "",
  "main": "src/main.ts",
  "type": "module",
  "engines": {
    "node": ">26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip --treat-tag-hints-as-errors",
    "serve": "vite preview",
    "test": "npm run test:unit && npm run build",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "prepare": "husky",
    "test:browser": "vitest run --project browser --reporter minimal --reporter json --outputFile=./test-results/browser-tests.json",
    "tsc": "tsc",
    "static-check": "./tools/check.py"
  },
  "repository": {},
  "keywords": [
    "excalibur",
    "excaliburjs",
    "vite",
    "game-engine"
  ],
  "author": "",
  "license": "",
  "bugs": {},
  "homepage": "",
  "dependencies": {
    "@excaliburjs/plugin-tiled": "0.32.0",
    "excalibur": "0.32.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.13",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.1.7",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "oxlint": "^1.67.0",
    "playwright": "^1.60.0",
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "vitest": "^4.1.6",
    "vitest-browser-react": "^2.2.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.0": true
  }
}
